generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Identity -----------------------------------------------------------
// A user may hold Rider and Partner roles simultaneously. Verification
// (phone + Ghana Card + selfie) is shared between the two roles and is
// never re-collected; vehicle documents (Partner-only) live separately
// once the Partner onboarding flow is built.

model User {
  id        String  @id @default(uuid())
  phone     String  @unique
  firstName String?
  lastName  String?

  phoneVerifiedAt     DateTime?
  ghanaCardNumber     String?
  ghanaCardVerifiedAt DateTime?
  selfieVerifiedAt    DateTime?

  isRider   Boolean @default(true)
  isPartner Boolean @default(false)
  // Stand-in for the ops dashboard's access control (not built — step 9).
  // Ops-only escrow actions (resolving a dispute, marking a no-show,
  // settling) are gated on this flag directly for now.
  isOps     Boolean @default(false)
  // Express driver identity (spec: drivers are employed by an Operator,
  // vetted through them, not independently onboarded). Step 10 gives this
  // its real backing (operatorId, set when an Operator adds someone to
  // their roster) but `become-driver` (step 8) still sets this flag
  // directly for a driver with no operator yet — documented as a
  // deliberately-kept self-service path alongside the real one, not a
  // stand-in that got replaced.
  isDriver  Boolean @default(false)

  // The Operator this driver is employed by, if any (see Operator model).
  // Null for a self-declared step-8 driver with no roster relationship.
  operator   Operator? @relation(fields: [operatorId], references: [id])
  operatorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps                PhoneOtp[]
  seatHolds           SeatHold[]
  partnerTrips        PartnerTrip[]
  partnerSeatHolds    PartnerSeatHold[]
  paymentIntents      PaymentIntent[]
  bookings            Booking[]
  assignedRuns        Run[]             @relation("RunDriver")
  operatorApplication Operator?         @relation("OperatorContact")
}

// One-time SMS codes for phone verification. Kept as its own table (rather
// than fields on User) because a phone can be re-verified and a user may
// not exist yet when the first code is requested.
model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([phone])
}

// --- Corridor / service / stop / run -------------------------------------
// A corridor is a commuter flow, not a route: one corridor carries several
// services, and each service has its own stop pattern and timetable. See
// "CityShare Handoff Spec" section 6.

model Corridor {
  id          String @id @default(uuid())
  name        String
  origin      String
  destination String

  createdAt DateTime @default(now())

  services          Service[]
  partnerTrips      PartnerTrip[]
  operatorInterests OperatorCorridorInterest[]
}

enum ServiceType {
  DIRECT
  STOPS
}

model Service {
  id         String      @id @default(uuid())
  corridor   Corridor    @relation(fields: [corridorId], references: [id])
  corridorId String
  code       String
  name       String
  type       ServiceType
  active     Boolean     @default(true)

  // One published fare per seat (spec section 2). DIRECT services quote a
  // single flat fare; STOPS services quote per leg via StopProfile.legFareCedis
  // and this is left null.
  flatFareCedis Int?

  stops StopProfile[]
  runs  Run[]

  @@unique([corridorId, code])
}

// Coordinates, scheduled times, dwell cap and board/alight rules for one
// stop on one service. Sequence orders the stops along the service.
model StopProfile {
  id        String  @id @default(uuid())
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String
  name      String
  sequence  Int

  lat Float
  lng Float

  // 24-hour, zero-padded, e.g. "06:18" — see design tokens (spec section 10).
  scheduledArrival   String?
  scheduledDeparture String?

  maxDwellSeconds Int     @default(180)
  boardAllowed    Boolean @default(true)
  alightAllowed   Boolean @default(true)

  // Fare for the leg ENDING at this stop (i.e. from the previous stop to
  // this one). Null on the first stop, which has no preceding leg. Only
  // used by STOPS services — see Service.flatFareCedis for DIRECT.
  legFareCedis Int?

  @@unique([serviceId, sequence])
}

enum RunStatus {
  SCHEDULED
  ASSIGNED
  CLOSED_UNASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// A dated instance of a service: an assigned vehicle, driver and manifest.
model Run {
  id        String    @id @default(uuid())
  service   Service   @relation(fields: [serviceId], references: [id])
  serviceId String
  date      DateTime
  status    RunStatus @default(SCHEDULED)

  // The Operator vehicle unit assigned to this run (step 10's Operator
  // console). Was a bare unused String field through steps 1-9 — nothing
  // ever set or read it, since there was no vehicle entity to reference.
  vehicle   OperatorVehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  driver   User?   @relation("RunDriver", fields: [driverId], references: [id])
  driverId String?

  // Total vehicle seats. Availability is derived per leg from SeatHold
  // records against this capacity — see src/services/inventory.ts.
  capacity Int

  createdAt DateTime @default(now())

  holds      SeatHold[]
  stopEvents RunStopEvent[]
  incidents  RunIncident[]

  @@unique([serviceId, date])
}

// A driver's arrival/departure at one stop on one run — what drives the
// dwell countdown (spec section 6: "maximum dwell is 3 minutes... a cap,
// not a negotiation, enforced in the driver app by a visible countdown")
// and the stop-by-stop on-time record on the run-complete screen.
// clientTimestamp-aware like everything else driver-tapped, for the same
// offline reason.
model RunStopEvent {
  id         String    @id @default(uuid())
  run        Run       @relation(fields: [runId], references: [id])
  runId      String
  stopId     String
  arrivedAt  DateTime?
  departedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([runId, stopId])
}

// "An incident report sheet that pushes position and manifest to ops"
// (spec section 8 screens) — read by the ops dashboard's live summary
// (step 9) via RunStopEvent; this table itself isn't surfaced there yet.
model RunIncident {
  id        String   @id @default(uuid())
  run       Run      @relation(fields: [runId], references: [id])
  runId     String
  category  String
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([runId])
}

// --- Express Operators ----------------------------------------------------
// A transport company that supplies vehicles and drivers for Express runs
// (spec section 9: "you provide vehicles, drivers, insurance; CityShare
// provides demand, inventory, payments"). Everywhere else in this codebase
// an "Operator" was a stand-in (isDriver/isPartner flags set directly) —
// this is the real entity those stand-ins were waiting on.
//
// One Operator per contact User (contactUserId), the same
// single-owner-per-entity pattern PartnerTrip.partnerId already uses —
// there's no multi-seat company-account model here.

enum OperatorStatus {
  APPLICATION
  CERTIFYING
  CERTIFIED
  // No route sets this yet — a real ops review flow (like the certification
  // checks below) would need to exist to revoke certification, and step 9's
  // ops dashboard doesn't have that action. Kept for completeness alongside
  // the corridor-level suspension the ops dashboard scorecard design shows.
  SUSPENDED
}

model Operator {
  id             String  @id @default(uuid())
  registeredName String
  rgdNumber      String?
  operatingSince Int?
  contactName    String?

  contactUser   User   @relation("OperatorContact", fields: [contactUserId], references: [id])
  contactUserId String @unique

  status      OperatorStatus @default(APPLICATION)
  submittedAt DateTime?
  createdAt   DateTime       @default(now())

  vehicles          OperatorVehicle[]
  corridorInterests OperatorCorridorInterest[]
  documents         OperatorDocument[]
  drivers           User[]
}

// An individually assignable vehicle (not an aggregate fleet count like
// the design's "4x Hyundai H1" application-step table — a real run
// assignment needs a specific vehicle, so this build tracks units
// directly, one row per vehicle, grouped by type only for display).
model OperatorVehicle {
  id          String   @id @default(uuid())
  operator    Operator @relation(fields: [operatorId], references: [id])
  operatorId  String
  label       String // e.g. "H1-07" — plate or fleet number
  vehicleType String // e.g. "Hyundai H1 · 11-seater"
  spec        String // e.g. "AC · WIFI · INSURED · TRACKED"
  seats       Int
  createdAt   DateTime @default(now())

  runs Run[]
}

// Which corridors an Operator wants to serve. Real and DB-driven — unlike
// the design's chip list (Western/Northwestern/Eastern/Madina, most of
// which aren't seeded corridors here), this only ever lists corridors
// that actually exist in this database.
model OperatorCorridorInterest {
  id         String   @id @default(uuid())
  operator   Operator @relation(fields: [operatorId], references: [id])
  operatorId String
  corridor   Corridor @relation(fields: [corridorId], references: [id])
  corridorId String
  createdAt  DateTime @default(now())

  @@unique([operatorId, corridorId])
}

enum OperatorDocKey {
  RGD_CERTIFICATE
  TRANSPORT_LICENCE
  DRIVER_ROSTER
  INSURANCE_ENDORSEMENT
  SAFETY_STANDARD_AGREEMENT
}

// Mock upload, same pattern as identity verification since step 1 (an
// instant "uploaded" timestamp, no real file storage or review) — see
// backend README blockers for why a real document pipeline isn't built.
model OperatorDocument {
  id         String         @id @default(uuid())
  operator   Operator       @relation(fields: [operatorId], references: [id])
  operatorId String
  key        OperatorDocKey
  uploadedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([operatorId, key])
}

enum HoldStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

// A seat (or seats) held against one leg-range of a Run. Express Stops
// sells per leg (spec section 2): a hold spans every leg between its
// board and alight stop, and inventory for any single leg is capacity
// minus the seats of every hold whose range covers that leg — see
// getLegAvailability in src/services/inventory.ts.
//
// PENDING holds expire 5 minutes after creation and are lazily reaped
// (flipped to EXPIRED) the next time availability is computed; there is
// no background sweep yet.
model SeatHold {
  id    String @id @default(uuid())
  run   Run    @relation(fields: [runId], references: [id])
  runId String

  boardStopId  String
  alightStopId String

  seats  Int
  status HoldStatus @default(PENDING)

  rider   User   @relation(fields: [riderId], references: [id])
  riderId String

  // Locked in at hold creation (see computeRunFare) so the amount charged
  // can never drift from what the rider was quoted, even if fares change
  // before payment completes.
  fareCedis Int

  expiresAt DateTime
  createdAt DateTime @default(now())

  booking Booking?

  @@index([runId, status])
}

// --- Partner trips --------------------------------------------------------
// An individual listing 1-4 seats on a journey they are already making
// (spec section 1/2). Single leg only — no per-segment inventory, unlike
// Express Stops. Partner onboarding (vehicle documents, comfort facts
// capture) is not built yet; isPartner is set directly for now.
model PartnerTrip {
  id        String @id @default(uuid())
  partner   User   @relation(fields: [partnerId], references: [id])
  partnerId String

  corridor   Corridor? @relation(fields: [corridorId], references: [id])
  corridorId String?

  originName      String
  originLat       Float
  originLng       Float
  destinationName String
  destLat         Float
  destLng         Float

  departAt DateTime

  // The driver's own seat is never sellable (spec section 2) — this is
  // passenger seats only, capped at 4 by onboarding (not yet built).
  seatsTotal       Int
  farePerSeatCedis Int

  vehicleDescription String
  comfortAc          Boolean @default(false)
  comfortUsb         Boolean @default(false)
  comfortBoot        Boolean @default(false)

  status    RunStatus @default(SCHEDULED)
  createdAt DateTime  @default(now())

  holds PartnerSeatHold[]
}

model PartnerSeatHold {
  id     String      @id @default(uuid())
  trip   PartnerTrip @relation(fields: [tripId], references: [id])
  tripId String

  seats  Int
  status HoldStatus @default(PENDING)

  rider   User   @relation(fields: [riderId], references: [id])
  riderId String

  fareCedis Int

  expiresAt DateTime
  createdAt DateTime @default(now())

  booking Booking?

  @@index([tripId, status])
}

// --- Payment (mock) --------------------------------------------------------
// No MoMo merchant agreement exists yet — see root README "Building the
// money path before MoMo is signed". This mocks the provider interface
// documented there so booking/escrow can be built and tested now; a real
// provider is a swap behind src/services/paymentProvider.ts, not a rewrite.
//
// The mock resolves lazily: the eventual outcome is decided at creation
// time (by a test convention — see paymentProvider.ts) and only "revealed"
// once resolvesAt passes, the same pattern SeatHold expiry uses.

enum PaymentOutcome {
  PENDING
  APPROVED
  DECLINED
  TIMEOUT
}

model PaymentIntent {
  id             String         @id @default(uuid())
  rider          User           @relation(fields: [riderId], references: [id])
  riderId        String
  amountCedis    Int
  reference      String
  idempotencyKey String         @unique
  status         PaymentOutcome @default(PENDING)
  outcome        PaymentOutcome
  resolvesAt     DateTime
  createdAt      DateTime       @default(now())

  booking Booking?
  refunds Refund[]
}

model Refund {
  id            String         @id @default(uuid())
  paymentIntent PaymentIntent  @relation(fields: [intentId], references: [id])
  intentId      String
  amountCedis   Int
  reason        String
  status        PaymentOutcome @default(PENDING)
  resolvesAt    DateTime
  createdAt     DateTime       @default(now())
}

model Payout {
  id          String         @id @default(uuid())
  payeeId     String
  amountCedis Int
  reference   String
  status      PaymentOutcome @default(PENDING)
  failReason  String?
  resolvesAt  DateTime
  createdAt   DateTime       @default(now())
}

// --- Booking + escrow --------------------------------------------------
// A Booking is what a SeatHold/PartnerSeatHold becomes once the rider
// pays for it. Escrow is CityShare's own ledger — HELD / RELEASABLE /
// DISPUTED / FORFEIT are states in this database, never inferred from the
// payment provider (spec: "Building the money path" rules).

enum BookingKind {
  RUN
  PARTNER
}

model Booking {
  id   String      @id @default(uuid())
  kind BookingKind

  rider   User   @relation(fields: [riderId], references: [id])
  riderId String

  runHold       SeatHold?        @relation(fields: [runHoldId], references: [id])
  runHoldId     String?          @unique
  partnerHold   PartnerSeatHold? @relation(fields: [partnerHoldId], references: [id])
  partnerHoldId String?          @unique

  // Locked in from the hold at payment time — never recomputed.
  seats     Int
  fareCedis Int

  // Set once escrow reaches HELD (spec section 3: "payment captured; seat
  // confirmed; ticket issued").
  boardingCode String?

  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  paymentIntentId String        @unique

  // Two-sided boarding (spec section 4). Timestamps are caller-supplied
  // when available (see tapBoarded in src/services/booking.ts) so an
  // offline driver tap keeps its original tap time through the sync —
  // "the recorded time is the tap, never the sync" (spec section 11).
  driverBoardedAt DateTime?
  driverBoardLat  Float?
  driverBoardLng  Float?
  riderBoardedAt  DateTime?
  riderBoardLat   Float?
  riderBoardLng   Float?

  createdAt DateTime @default(now())

  escrow        Escrow?
  locationPings LocationPing[]
  transfers     BookingTransfer[]
}

// Reassignment audit trail (spec section 5: "reassignment is deliberately
// the better option... on transfer, the original rider loses boarding
// rights immediately, a new boarding code is issued to the recipient").
// Append-only, same spirit as EscrowLedgerEntry but for booking ownership
// rather than escrow state.
model BookingTransfer {
  id          String   @id @default(uuid())
  booking     Booking  @relation(fields: [bookingId], references: [id])
  bookingId   String
  fromRiderId String
  toRiderId   String
  createdAt   DateTime @default(now())

  @@index([bookingId])
}

// The rider's location trail for the trip window (spec section 4:
// "the decisive evidence is the rider's location trail against the
// vehicle's route"). Append-only, client-timestamped for the same
// offline reason as the boarding taps.
model LocationPing {
  id         String   @id @default(uuid())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  bookingId  String
  lat        Float
  lng        Float
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([bookingId])
}

enum EscrowState {
  PENDING
  HELD
  RELEASABLE
  DISPUTED
  REFUNDING
  REFUNDED
  FORFEIT
  SETTLED
  VOID
}

enum EscrowActorType {
  SYSTEM
  RIDER
  DRIVER
  OPS
}

model Escrow {
  id          String      @id @default(uuid())
  booking     Booking     @relation(fields: [bookingId], references: [id])
  bookingId   String      @unique
  state       EscrowState @default(PENDING)
  amountCedis Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ledger EscrowLedgerEntry[]
}

// Append-only. Every transition is written here with actor, timestamp and
// an evidence reference (spec section 3 invariant) — entries are never
// updated or deleted, and disputes are decided from this table, not from
// Escrow.state alone.
model EscrowLedgerEntry {
  id        String          @id @default(uuid())
  escrow    Escrow          @relation(fields: [escrowId], references: [id])
  escrowId  String
  fromState EscrowState?
  toState   EscrowState
  actorType EscrowActorType
  actorId   String?
  evidence  Json?
  createdAt DateTime        @default(now())

  @@index([escrowId])
}
